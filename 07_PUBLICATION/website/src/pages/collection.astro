---
import Layout from '../layouts/Layout.astro';

const primitives = [
  "EXIST", "CAUSE", "PART", "SAME", "ONE", "ALL", "NOT", "IF", "DO", "HAPPEN",
  "KNOW", "SEE", "BIG", "LIVE", "DIE", "MOVE", "THINK", "SAY", "TRUE", "GOOD"
];
---
<Layout title="Collection">
  <h1>L.E.U. Genesis Collection</h1>
  <p>The 20 Live Artifacts. Each one is a self-executing SVG that displays its own SHA-256, GPG fingerprint, and real-time clock. Click to open.</p>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin-top: 2rem;">
    {primitives.map((p) => (
      <div style="border: 1px solid #eaeaea; border-radius: 8px; overflow: hidden; background: #fff; text-align: center; padding: 1rem;">
        <h3 style="margin: 0 0 10px 0; font-size: 1.2rem; color: #1a1a2e;">{p}</h3>
        <a href={`/live_${p}.svg`} target="_blank" style="display: inline-block; padding: 8px 16px; background: #17becf; color: #fff; text-decoration: none; border-radius: 4px; font-size: 0.9rem;">▶ Open Live Artifact</a>
      </div>
    ))}
  </div>
</Layout>
