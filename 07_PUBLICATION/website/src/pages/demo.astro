---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
// On lit le contenu du SVG directement depuis le dossier public
const svgPath = path.join(process.cwd(), 'public', 'glyph_agentic_v2.svg');
const svgContent = fs.readFileSync(svgPath, 'utf-8');
---
<Layout title="Demo">
  <h1>Agentic Glyph</h1>
  <p>This SVG is not an image; it is an agent. Click <strong>EVALUATE + PLAY</strong> to execute an L.E.U. expression. Click <strong>SEAL</strong> to hash the state.</p>
  
  <div style="margin-top: 2rem; border: 1px solid #eaeaea; border-radius: 8px; overflow: hidden; background: white;">
    <!-- Injection directe du SVG dans le DOM -->
    <div set:html={svgContent}></div>
  </div>
</Layout>
