---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Demo">
  <h1>Agentic Glyph</h1>
  <p>Due to browser security restrictions, interactive SVGs cannot run inside an iframe. Click the button below to open the standalone Agentic Glyph in a new tab, where it becomes fully interactive.</p>
  
  <div style="margin-top: 2rem; text-align: center;">
    <a href="/glyph_agentic_v2.svg" target="_blank" style="display: inline-block; padding: 1rem 2rem; background: #17becf; color: white; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 1.2rem;">
      ▶ Open Interactive Glyph
    </a>
  </div>
</Layout>
