---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Demo">
  <h1>Agentic Glyph</h1>
  <p>This SVG is not an image; it is an agent. It contains its own parser, evaluator, state, and Web Audio synthesizer. Click <strong>EVALUATE + PLAY</strong> to execute an Alpha-20 expression and hear the mathematics. Click <strong>SEAL</strong> to hash the internal state with SHA-256.</p>
  
  <div style="margin-top: 2rem; border: 1px solid #eaeaea; border-radius: 8px; overflow: hidden; background: white;">
    <iframe src="/glyph_agentic_v2.svg" width="100%" height="800px" style="border: none;"></iframe>
  </div>
</Layout>
