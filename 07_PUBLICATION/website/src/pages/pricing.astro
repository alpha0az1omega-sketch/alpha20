---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pricing & Licensing">
  <h1>Licensing</h1>
  <p>L.E.U. is open-source. Commercial licenses are available for proprietary integration.</p>
  <div style="display: flex; gap: 20px; margin-top: 30px;">
    <div style="flex: 1; padding: 20px; border: 1px solid #ddd; border-radius: 8px;">
      <h2 style="margin-top: 0;">Open Source</h2>
      <p style="font-size: 24px; font-weight: bold;">Free</p>
      <ul style="font-size: 14px; color: #666;">
        <li>PolyForm Noncommercial License</li>
        <li>Full source code</li>
        <li>Community support</li>
        <li>Must open-source derivatives</li>
      </ul>
    </div>
    <div style="flex: 1; padding: 20px; border: 2px solid #17becf; border-radius: 8px;">
      <h2 style="margin-top: 0;">Commercial</h2>
      <p style="font-size: 24px; font-weight: bold;">Contact Us</p>
      <ul style="font-size: 14px; color: #666;">
        <li>Private use allowed</li>
        <li>No need to open-source your code</li>
        <li>Priority support</li>
        <li>Custom integration</li>
      </ul>
      <a href="/contact" style="display: inline-block; margin-top: 10px; padding: 10px 20px; background: #17becf; color: #fff; border-radius: 4px; text-decoration: none;">Contact for Pricing</a>
    </div>
  </div>
</Layout>
