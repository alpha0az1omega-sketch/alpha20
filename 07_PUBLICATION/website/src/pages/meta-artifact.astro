---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Meta-Artifact">
  <style>
    .meta-container {
      display: grid;
      grid-template-columns: 200px 1fr 200px;
      gap: 20px;
      height: 80vh;
      overflow: hidden;
      background: #050505;
      border-radius: 12px;
      border: 1px solid #222;
      margin-top: 2rem;
    }
    .matrix-col {
      position: relative;
      overflow: hidden;
      opacity: 0.6;
    }
    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    .center-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .artifact-frame {
      width: 100%;
      height: 60%;
      border: none;
      border-radius: 8px;
      box-shadow: 0 0 30px rgba(23, 190, 207, 0.2);
    }
    .qr-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: #0a0a0a;
      border-left: 1px solid #222;
    }
    .qr-col img {
      width: 150px;
      border-radius: 8px;
      background: white;
      padding: 10px;
    }
    .scene-3d {
      width: 100%;
      height: 100px;
      perspective: 1000px;
      margin-top: 20px;
    }
    .ring {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      animation: spin 15s linear infinite;
    }
    @keyframes spin {
      0% { transform: rotateY(0deg); }
      100% { transform: rotateY(360deg); }
    }
    .dot-3d {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 10px;
      height: 10px;
      background: #17becf;
      border-radius: 50%;
      box-shadow: 0 0 10px #17becf;
    }
  </style>

  <h1>L.E.U. // META-ARTIFACT</h1>
  <p style="color: #888; font-family: monospace;">Matrix | Live Artifact | 3D Ring | QR</p>

  <div class="meta-container">
    <div class="matrix-col">
      <canvas id="matrix"></canvas>
    </div>

    <div class="center-col">
      <object type="image/svg+xml" data="/live_MOVE.svg" class="artifact-frame"></object>
      <div class="scene-3d">
        <div class="ring" id="ring"></div>
      </div>
    </div>

    <div class="qr-col">
      <h3 style="color: #17becf; font-family: monospace; font-size: 1rem; margin-bottom: 20px;">SCAN TO VERIFY</h3>
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://alpha0az1omega.com/collection/" alt="QR Code" />
      <p style="color: #555; font-size: 0.8rem; text-align: center; margin-top: 20px;">Redirects to the<br/>Genesis Collection</p>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('matrix');
    const ctx = canvas.getContext('2d');
    canvas.width = canvas.parentElement.clientWidth;
    canvas.height = canvas.parentElement.clientHeight;

    const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*';
    const fontSize = 14;
    const columns = canvas.width / fontSize;
    const drops = [];
    for (let x = 0; x < columns; x++) drops[x] = 1;

    function drawMatrix() {
      ctx.fillStyle = 'rgba(5, 5, 5, 0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#17becf';
      ctx.font = fontSize + 'px monospace';
      for (let i = 0; i < drops.length; i++) {
        const text = letters.charAt(Math.floor(Math.random() * letters.length));
        ctx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) { drops[i] = 0; }
        drops[i]++;
      }
    }
    setInterval(drawMatrix, 50);

    const ring = document.getElementById('ring');
    const numDots = 20;
    for (let i = 0; i < numDots; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot-3d';
      const angle = (i / numDots) * Math.PI * 2;
      const radius = 100;
      const x = Math.cos(angle) * radius;
      const z = Math.sin(angle) * radius;
      dot.style.transform = `translate3d(${x}px, 0, ${z}px)`;
      ring.appendChild(dot);
    }
  </script>
</Layout>
