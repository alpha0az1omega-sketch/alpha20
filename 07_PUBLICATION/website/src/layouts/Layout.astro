---
export interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | L.E.U.</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <!-- Open Graph / Social Media -->
  <meta property="og:title" content={`${title} | L.E.U.`} />
  <meta property="og:description" content="Lingua Executabilis Universalis: A Universal, Executable, and Cryptographic Language." />
  <meta property="og:image" content="https://alpha0az1omega.com/logo.png" />
  <meta property="og:url" content="https://alpha0az1omega.com" />
  <meta name="twitter:card" content="summary_large_image" />

  <style>
    :root { --bg: #fafafa; --text: #1a1a2e; --accent: #17becf; --muted: #666; }
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: var(--bg); color: var(--text); line-height: 1.6; max-width: 900px; margin: 0 auto; padding: 2rem; }
    h1, h2, h3 { font-weight: 600; letter-spacing: -0.02em; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    nav { display: flex; gap: 1.5rem; margin-bottom: 4rem; border-bottom: 1px solid #eaeaea; padding-bottom: 1rem; flex-wrap: wrap; }
    nav a { color: var(--muted); font-weight: 500; }
    nav a:hover { color: var(--text); }
    code, pre { font-family: 'IBM Plex Mono', monospace; background: #f0f0f0; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
  </style>
</head>
<body>
  <nav>
    <a href="/" style="font-weight: bold; color: #17becf;">L.E.U.</a>
    <a href="/demo">Demo</a>
    <a href="/playground-v2">Playground V2</a>
    <a href="/collection">Collection</a>
    <a href="/meta-artifact" style="color: #ff7f0e; font-weight: bold;">Meta-Artifact</a>
    <a href="/verify">Verify</a>
    <a href="/prompt-forge">Prompt Forge</a>
    <a href="/pricing">Pricing</a>
    <a href="/contact">Contact</a>
    <a href="https://github.com/alpha0az1omega-sketch/lingua-executabilis-universalis" target="_blank">GitHub</a>
    <a href="/hub" style="color: #d4af37; font-weight: bold;">Hub</a>
    <a href="/quests" style="color: #2ca02c; font-weight: bold;">Quests</a>
   <a href="/portal" style="color: #d4af37; font-weight: bold;">Portal of Infinity</a> 
  </nav>
  <main><slot /></main>
</body>
</html>
