{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TELA_Contract",
  "type": "object",
  "required": ["agent_id", "expression", "sha256", "signature"],
  "properties": {
    "agent_id": { "type": "string" },
    "expression": { 
      "type": "string", 
      "description": "The L.E.U. logical proof (e.g., CAUSE(action, benefit) AND NOT(CAUSE(action, harm)))" 
    },
    "sha256": { "type": "string" },
    "signature": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
